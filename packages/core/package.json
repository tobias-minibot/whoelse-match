{
  "name": "@whoelse/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./amaze": {
      "types": "./src/amaze.ts",
      "import": "./src/amaze.ts",
      "default": "./dist/amaze.js"
    },
    "./vocab-search": {
      "types": "./src/vocab-search.ts",
      "import": "./src/vocab-search.ts",
      "default": "./dist/vocab-search.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
