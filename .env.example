# Copy names only. Pull real values with:
#   cd packages/web && npx vercel link --yes --project whoelse-dating
#   npx vercel env pull .env.local --yes
# Do not invent secrets. Do not commit .env.local.

# Neon (Vercel Marketplace resource `whoelse` on project whoelse-dating)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
NEON_PROJECT_ID=

# Clerk (Vercel Marketplace resource `whoelse`)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Seed policy. Production (VERCEL_ENV=production) boots empty unless this is `demo`.
# Local `pnpm dev` defaults to the labeled synthetic seed.
WHOELSE_SEED=

# Optional: stdio MCP writes (`pnpm mcp`) authenticate as this agent key.
WHOELSE_AGENT_KEY=

# Optional rerank / richer AI chat
OPENAI_API_KEY=

# Optional MCP HTTP dogfood
WHOELSE_MCP_URL=
WHOELSE_SEED_PATH=
